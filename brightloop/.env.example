POSTGRES_DB=brightloop
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=brightloop_local
DATABASE_URL=postgresql://brightloop:brightloop_local@localhost:5432/brightloop
JWT_SECRET=replace-this-for-local-development
ADMIN_BOOTSTRAP_TOKEN=replace-this-with-a-long-random-one-time-token
COOKIE_SECURE=false
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE=/api
# Optional when Next.js and FastAPI are not on the same host/network.
# API_INTERNAL_URL=http://127.0.0.1:8000
