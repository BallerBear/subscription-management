POSTGRES_DB=brightloop
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=brightloop_local
# TEAM SETUP (recommended, works on Windows/Mac/Linux with no Docker):
# everyone uses the SAME shared Supabase database. Ask Soorya for the
# Session pooler string (port 5432, NOT the transaction pooler on 6543) and paste it here:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# SOLO/OFFLINE setup (needs Docker; you get an EMPTY private database, run migrate + seed yourself):
DATABASE_URL=postgresql://brightloop:brightloop_local@localhost:5432/brightloop
# Only needed for password-reset emails (Mailpit). Without it the link prints in the API console.
SMTP_HOST=localhost
SMTP_PORT=1025
APP_BASE_URL=http://localhost:3000
JWT_SECRET=replace-this-for-local-development
ADMIN_BOOTSTRAP_TOKEN=replace-this-with-a-long-random-one-time-token
COOKIE_SECURE=false
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE=/api
# Optional when Next.js and FastAPI are not on the same host/network.
# API_INTERNAL_URL=http://127.0.0.1:8000
